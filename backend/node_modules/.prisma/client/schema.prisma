generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model StudentProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String?
  rollNumber     String          @unique
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  programId      String
  program        AcademicProgram @relation(fields: [programId], references: [id])
  graduationYear Int
  cgpa           Float
  backlogCount   Int             @default(0)
  skills         String[]
  projects       Json?
  certifications Json?
  experience     Json?
  resumeUrl      String?

  applications Application[]
  savedJobs    SavedJob[]
  offers       PlacementOffer[]
}

model RecruiterProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model Company {
  id          String  @id @default(uuid())
  name        String
  industry    String?
  website     String?
  description String?
  address     String?
  isApproved  Boolean @default(false)

  recruiters RecruiterProfile[]
  jobs       Job[]
}

model Department {
  id       String           @id @default(uuid())
  name     String
  code     String           @unique
  students StudentProfile[]
  jobs     Job[]
}

model AcademicProgram {
  id       String           @id @default(uuid())
  name     String
  level    String // e.g., BTech, MTech
  students StudentProfile[]
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
}

model Job {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  title            String
  description      String
  responsibilities String?
  location         String
  jobType          JobType
  salaryRange      String?
  deadline         DateTime
  isApproved       Boolean  @default(false)
  isActive         Boolean  @default(true)

  // Eligibility
  minCgpa             Float        @default(0)
  maxBacklogs         Int          @default(0)
  graduationYear      Int?
  eligibleDepartments Department[]
  skills              String[]

  applications Application[]
  savedBy      SavedJob[]
  interviews   Interview[]
}

enum AppStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

model Application {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id])
  status    AppStatus      @default(APPLIED)
  appliedAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  resumeUrl String?

  interviews Interview[]
  offer      PlacementOffer?

  @@unique([studentId, jobId])
}

model SavedJob {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id])
  savedAt   DateTime       @default(now())

  @@unique([studentId, jobId])
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id])
  scheduledAt   DateTime
  mode          String // VIRTUAL, IN_PERSON
  locationLink  String?
  instructions  String?
  status        String // SCHEDULED, COMPLETED, CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model PlacementOffer {
  id            String         @id @default(uuid())
  applicationId String         @unique
  application   Application    @relation(fields: [applicationId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  packageValue  String
  offerDate     DateTime
  joiningDate   DateTime?
  expiryDate    DateTime?
  status        OfferStatus    @default(PENDING)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
